!! animal is tiger
!#set1 animal "tiger"
!#include ifelse_animal.imf
!
!! animal is elephant
!#set1 animal "elephant"
!#include ifelse_animal.imf
!
!! animal is lion
!#set1 animal "lion"
!#include ifelse_animal.imf
